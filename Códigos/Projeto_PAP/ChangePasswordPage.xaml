<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Projeto_PAP.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projeto_PAP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

        <Border 
            Background="White" 
            CornerRadius="16" 
            Padding="50"
            BorderBrush="#e0e0e0"
            BorderThickness="1"
            MaxWidth="450">

            <StackPanel Spacing="25">

                <!-- Ícone -->
                <Border 
                    Background="#E8F0FE" 
                    CornerRadius="40" 
                    Width="80" 
                    Height="80"
                    HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8D7;" FontSize="36" Foreground="#667eea"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Título -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock 
                        x:Uid="ChangePassword_Title"
                        Text="Create New Password"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#1a1a2e"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        x:Uid="ChangePassword_Subtitle"
                        Text="Enter your new master password below."
                        FontSize="13"
                        Foreground="#888888"
                        HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Nova Password -->
                <StackPanel Spacing="8">
                    <TextBlock 
                        x:Uid="ChangePassword_NewPassword"
                        Text="New Password"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#333333"/>
                    <PasswordBox 
                        x:Name="NewPasswordBox"
                        PlaceholderText="••••••••"
                        FontSize="16"
                        Padding="15,12"
                        CornerRadius="10"/>
                </StackPanel>

                <!-- Confirmar Password -->
                <StackPanel Spacing="8">
                    <TextBlock 
                        x:Uid="ChangePassword_ConfirmPassword"
                        Text="Confirm Password"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#333333"/>
                    <PasswordBox 
                        x:Name="ConfirmPasswordBox"
                        PlaceholderText="••••••••"
                        FontSize="16"
                        Padding="15,12"
                        CornerRadius="10"/>
                </StackPanel>

                <!-- Mensagem de erro -->
                <Border 
                    x:Name="ErrorPanel"
                    Background="#FFEBEE" 
                    CornerRadius="8" 
                    Padding="15"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="#e74c3c"/>
                        <TextBlock 
                            x:Name="ErrorText"
                            Foreground="#e74c3c"
                            FontSize="13"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Botão Guardar -->
                <Button 
                    x:Name="SaveButton"
                    x:Uid="ChangePassword_SaveButton"
                    Content="Save New Password"
                    Click="SaveButton_Click"
                    Background="#667eea"
                    Foreground="White"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Padding="20,15"
                    CornerRadius="10"
                    HorizontalAlignment="Stretch"/>

                <!-- Botão Cancelar -->
                <Button 
                    x:Name="CancelButton"
                    x:Uid="ChangePassword_CancelButton"
                    Content="Cancel"
                    Click="CancelButton_Click"
                    Background="Transparent"
                    Foreground="#888888"
                    FontSize="14"
                    Padding="20,10"
                    HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>