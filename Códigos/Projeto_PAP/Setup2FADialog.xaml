<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Projeto_PAP.Setup2FADialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projeto_PAP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="20" Width="400" Padding="10">

        <!-- Aviso Importante -->
        <Border Background="#FFF3CD" CornerRadius="8" Padding="15">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#856404"/>
                    <TextBlock 
                        x:Uid="Setup2FA_WarningTitle"
                        Text="Two-Factor Authentication Required"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Foreground="#856404"/>
                </StackPanel>
                <TextBlock 
                    x:Uid="Setup2FA_WarningText"
                    Text="To continue using this application, you must set up two-factor authentication for your security."
                    TextWrapping="Wrap"
                    FontSize="13"
                    Foreground="#856404"/>
            </StackPanel>
        </Border>

        <!-- Instruções -->
        <StackPanel Spacing="10">
            <TextBlock 
                x:Uid="Setup2FA_Step1"
                Text="1. Install Google Authenticator on your phone"
                FontSize="13"
                Foreground="#333333"/>
            <TextBlock 
                x:Uid="Setup2FA_Step2"
                Text="2. Scan the QR Code below"
                FontSize="13"
                Foreground="#333333"/>
        </StackPanel>

        <!-- QR Code -->
        <Border 
            Background="White" 
            CornerRadius="10" 
            Padding="20"
            HorizontalAlignment="Center"
            BorderBrush="#e0e0e0"
            BorderThickness="1">
            <Image 
                x:Name="QRCodeImage"
                Width="200"
                Height="200"
                Stretch="Uniform"/>
        </Border>

        <!-- Chave manual (caso QR não funcione) -->
        <StackPanel Spacing="5" HorizontalAlignment="Center">
            <TextBlock 
                x:Uid="Setup2FA_ManualEntry"
                Text="Can't scan? Enter this code manually:"
                FontSize="12"
                Foreground="#888888"
                HorizontalAlignment="Center"/>
            <Border Background="#f5f5f5" CornerRadius="6" Padding="10,5">
                <TextBlock 
                    x:Name="SecretKeyText"
                    Text=""
                    FontFamily="Consolas"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#333333"
                    IsTextSelectionEnabled="True"/>
            </Border>
        </StackPanel>

        <!-- Introduzir código -->
        <StackPanel Spacing="10">
            <TextBlock 
                x:Uid="Setup2FA_Step3"
                Text="3. Enter the 6-digit code from the app:"
                FontSize="13"
                Foreground="#333333"/>

            <TextBox 
                x:Name="CodeBox"
                x:Uid="Setup2FA_CodeBox"
                PlaceholderText="000000"
                MaxLength="6"
                FontSize="24"
                FontFamily="Consolas"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                Width="200"
                CornerRadius="8"
                Padding="10"
                InputScope="NumericPin"/>
        </StackPanel>

        <!-- Mensagem de erro -->
        <TextBlock 
            x:Name="ErrorMessage"
            x:Uid="Setup2FA_Error"
            Text="Invalid code. Please try again."
            Foreground="#e74c3c"
            FontSize="13"
            HorizontalAlignment="Center"
            Visibility="Collapsed"/>

    </StackPanel>
</UserControl>