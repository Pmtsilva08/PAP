<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Projeto_PAP.AddPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projeto_PAP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="15" Width="400">

        <!-- Site Name -->
        <StackPanel Spacing="5">
            <TextBlock 
                x:Uid="AddDialogSiteName"
                Text="Site Name"
                FontWeight="SemiBold"
                Foreground="#333333"/>
            <TextBox 
                x:Name="SiteNameBox"
                x:Uid="AddDialogSiteNameBox"
                PlaceholderText="e.g. Google, Facebook..."
                CornerRadius="6"
                Padding="10"/>
        </StackPanel>

        <!-- URL -->
        <StackPanel Spacing="5">
            <TextBlock 
                x:Uid="AddDialogUrl"
                Text="URL"
                FontWeight="SemiBold"
                Foreground="#333333"/>
            <TextBox 
                x:Name="UrlBox"
                x:Uid="AddDialogUrlBox"
                PlaceholderText="https://example.com"
                CornerRadius="6"
                Padding="10"/>
        </StackPanel>

        <!-- Email/Username -->
        <StackPanel Spacing="5">
            <TextBlock 
                x:Uid="AddDialogEmail"
                Text="Email / Username"
                FontWeight="SemiBold"
                Foreground="#333333"/>
            <TextBox 
                x:Name="EmailBox"
                x:Uid="AddDialogEmailBox"
                PlaceholderText="your@email.com"
                CornerRadius="6"
                Padding="10"/>
        </StackPanel>

        <!-- Password -->
        <StackPanel Spacing="5">
            <TextBlock 
                x:Uid="AddDialogPassword"
                Text="Password"
                FontWeight="SemiBold"
                Foreground="#333333"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PasswordBox 
                    x:Name="PasswordBox"
                    x:Uid="AddDialogPasswordBox"
                    Grid.Column="0"
                    PlaceholderText="Enter password"
                    CornerRadius="6"
                    Padding="10"
                    PasswordRevealMode="Hidden"/>

                <!-- Toggle View Password -->
                <Button 
                    x:Name="TogglePasswordButton"
                    Grid.Column="1"
                    Background="Transparent"
                    Padding="10"
                    Margin="5,0,0,0"
                    CornerRadius="6"
                    Click="TogglePasswordButton_Click"
                    ToolTipService.ToolTip="Show/Hide password">
                    <FontIcon 
                        x:Name="TogglePasswordIcon"
                        Glyph="&#xE7B3;" 
                        FontSize="16" 
                        Foreground="#667eea"/>
                </Button>

                <!-- Generate Password -->
                <Button 
                    x:Name="GeneratePasswordButton"
                    Grid.Column="2"
                    Background="Transparent"
                    Padding="10"
                    Margin="5,0,0,0"
                    CornerRadius="6"
                    Click="GeneratePasswordButton_Click"
                    ToolTipService.ToolTip="Generate strong password">
                    <FontIcon 
                        Glyph="&#xE72E;" 
                        FontSize="16" 
                        Foreground="#667eea"/>
                </Button>
            </Grid>

            <!-- Password Strength Indicator -->
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar 
                    x:Name="PasswordStrengthBar"
                    Grid.Column="0"
                    Value="0"
                    Maximum="100"
                    Height="5"
                    CornerRadius="2"/>

                <TextBlock 
                    x:Name="PasswordStrengthText"
                    Grid.Column="1"
                    Text=""
                    FontSize="12"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Category -->
        <StackPanel Spacing="5">
            <TextBlock 
                x:Uid="AddDialogCategory"
                Text="Category"
                FontWeight="SemiBold"
                Foreground="#333333"/>
            <ComboBox 
                x:Name="CategoryBox"
                x:Uid="AddDialogCategoryBox"
                CornerRadius="6"
                HorizontalAlignment="Stretch">
                <ComboBoxItem x:Uid="CategorySocial" Content="Social" IsSelected="True"/>
                <ComboBoxItem x:Uid="CategoryWork" Content="Work"/>
                <ComboBoxItem x:Uid="CategoryBank" Content="Bank"/>
                <ComboBoxItem x:Uid="CategoryOther" Content="Other"/>
            </ComboBox>
        </StackPanel>

        <!-- Notes -->
        <StackPanel Spacing="5">
            <TextBlock 
                x:Uid="AddDialogNotes"
                Text="Notes (optional)"
                FontWeight="SemiBold"
                Foreground="#333333"/>
            <TextBox 
                x:Name="NotesBox"
                x:Uid="AddDialogNotesBox"
                PlaceholderText="Additional notes..."
                CornerRadius="6"
                Padding="10"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Height="80"/>
        </StackPanel>

        <!-- Error Message -->
        <TextBlock 
            x:Name="ErrorMessage"
            x:Uid="AddDialogError"
            Text="Please fill in all required fields."
            Foreground="#e74c3c"
            FontSize="13"
            Visibility="Collapsed"
            Margin="0,5,0,0"/>

    </StackPanel>
</UserControl>
