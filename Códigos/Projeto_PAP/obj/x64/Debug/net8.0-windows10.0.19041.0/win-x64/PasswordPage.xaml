<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="Projeto_PAP.PasswordsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projeto_PAP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F5F5F5">

    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:ConnectionId='15' 
                x:Name="PageTitle"
                x:Uid="PasswordsPageTitle"
                Grid.Column="0"
                Text="My Passwords"
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="#1a1a2e"/>

            <Button x:ConnectionId='16' 
                x:Name="AddButton"
                Grid.Column="1"
                                       
                Padding="15,10"
                CornerRadius="8">

                <Button.Resources>
                    <Storyboard x:Key="HoverIn">
                        <ColorAnimation 
                            Storyboard.TargetName="AddButtonBackground"
                            Storyboard.TargetProperty="Color"
                            To="#5a6fd6"
                            Duration="0:0:0.2"/>
                    </Storyboard>
                    <Storyboard x:Key="HoverOut">
                        <ColorAnimation 
                            Storyboard.TargetName="AddButtonBackground"
                            Storyboard.TargetProperty="Color"
                            To="#667eea"
                            Duration="0:0:0.2"/>
                    </Storyboard>
                </Button.Resources>

                <Button.Background>
                    <SolidColorBrush x:ConnectionId='17' x:Name="AddButtonBackground" Color="#667eea"/>
                </Button.Background>

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border 
                                        x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                        <ContentPresenter 
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="White"/>
                    <TextBlock x:Uid="PasswordsAddButton" Text="Add Password" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search and Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box with Icon Inside -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <TextBox x:ConnectionId='14' 
                    x:Name="SearchBox"
                    x:Uid="PasswordsSearchBox"
                    PlaceholderText="Search passwords..."
                    Padding="40,10,10,10"
                    CornerRadius="8"
                    BorderBrush="#e0e0e0"
                    BorderThickness="1"
                    Background="White"
                                                       />

                <FontIcon 
                    Glyph="&#xE721;"
                    FontSize="16"
                    Foreground="#888888"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="12,0,0,0"
                    IsHitTestVisible="False"/>
            </Grid>

            <!-- Category Filter -->
            <ComboBox x:ConnectionId='13' 
                x:Name="CategoryFilter"
                x:Uid="PasswordsCategoryFilter"
                Grid.Column="1"
                PlaceholderText="All Categories"
                Width="180"
                CornerRadius="8"
                                                                  >
                <ComboBoxItem x:Uid="CategoryAll" Content="All" IsSelected="True"/>
                <ComboBoxItem x:Uid="CategorySocial" Content="Social"/>
                <ComboBoxItem x:Uid="CategoryWork" Content="Work"/>
                <ComboBoxItem x:Uid="CategoryBank" Content="Bank"/>
                <ComboBoxItem x:Uid="CategoryOther" Content="Other"/>
            </ComboBox>
        </Grid>

        <!-- Passwords List -->
        <ScrollViewer Grid.Row="2">
            <ListView x:ConnectionId='3' 
                x:Name="PasswordsList"
                                                
                SelectionMode="None"
                Background="Transparent">

                <ListView.ItemTemplate>
                    <DataTemplate                                >
                        <Grid x:ConnectionId='5' 
                            Background="White" 
                            CornerRadius="10" 
                            Padding="15" 
                            Margin="0,0,0,10"
                            BorderBrush="#e8e8e8"
                            BorderThickness="1">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <Grid 
                                Grid.Column="0" 
                                Width="45" 
                                Height="45" 
                                CornerRadius="10"
                                Background="#f0f0ff"
                                Margin="0,0,15,0">
                                <FontIcon 
                                    Glyph="&#xE774;"
                                    FontSize="20"
                                    Foreground="#667eea"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='10' 
                                                            
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#1a1a2e"/>
                                <TextBlock x:ConnectionId='11' 
                                                         
                                    FontSize="13"
                                    Foreground="#666666"
                                    Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock 
                                        x:Name="PasswordDisplay"
                                        Text="••••••••••••"
                                        FontSize="13"
                                        Foreground="#888888"
                                        FontFamily="Consolas"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel 
                                Grid.Column="2" 
                                Orientation="Horizontal" 
                                Spacing="5"
                                VerticalAlignment="Center">

                                <!-- View Password -->
                                <Button x:ConnectionId='6' 
                                    x:Uid="PasswordsViewButton"
                                    ToolTipService.ToolTip="View password"
                                    Background="Transparent"
                                    Padding="10"
                                    CornerRadius="8"
                                                              
                                                     >
                                    <FontIcon Glyph="&#xE7B3;" FontSize="16" Foreground="#667eea"/>
                                </Button>

                                <!-- Copy Password -->
                                <Button x:ConnectionId='7' 
                                    x:Uid="PasswordsCopyButton"
                                    ToolTipService.ToolTip="Copy password"
                                    Background="Transparent"
                                    Padding="10"
                                    CornerRadius="8"
                                                              
                                                     >
                                    <FontIcon Glyph="&#xE8C8;" FontSize="16" Foreground="#667eea"/>
                                </Button>

                                <!-- Edit Password -->
                                <Button x:ConnectionId='8' 
                                    x:Uid="PasswordsEditButton"
                                    ToolTipService.ToolTip="Edit"
                                    Background="Transparent"
                                    Padding="10"
                                    CornerRadius="8"
                                                              
                                                     >
                                    <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="#888888"/>
                                </Button>

                                <!-- Delete Password -->
                                <Button x:ConnectionId='9' 
                                    x:Uid="PasswordsDeleteButton"
                                    ToolTipService.ToolTip="Delete"
                                    Background="Transparent"
                                    Padding="10"
                                    CornerRadius="8"
                                                                
                                                     >
                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#e74c3c"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel x:ConnectionId='2' 
            x:Name="EmptyState"
            Grid.Row="2"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <FontIcon 
                Glyph="&#xE8D7;"
                FontSize="64"
                Foreground="#cccccc"/>
            <TextBlock 
                x:Uid="PasswordsEmptyTitle"
                Text="No passwords yet"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#888888"
                HorizontalAlignment="Center"
                Margin="0,20,0,5"/>
            <TextBlock 
                x:Uid="PasswordsEmptySubtitle"
                Text="Click 'Add Password' to get started"
                FontSize="14"
                Foreground="#aaaaaa"
                HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>

