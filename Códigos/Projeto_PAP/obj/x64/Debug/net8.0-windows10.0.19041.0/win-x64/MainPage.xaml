<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Projeto_PAP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projeto_PAP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--(SplitView) É o menu lateral-->
        <!--(DisplayMode) A maneira como o menu se vai comportar-->
        <!--(CompactPaneLength) Largura do menu quando está fechado-->
        <!--(OpenPaneLength) Largura do menu quando está aberto-->
        <SplitView x:ConnectionId='2' 
            x:Name="SplitView"
            DisplayMode="CompactInline" 
            IsPaneOpen="False"
            CompactPaneLength="50"
            OpenPaneLength="200"
                                               
                                               >

            <!--(SplitView.Pane) é o conteúdo do painel lateral-->
            <SplitView.Pane>
                <StackPanel>
                    <StackPanel.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0.0"/>
                            <GradientStop Color="#764ba2" Offset="1.0"/>
                        </LinearGradientBrush>
                    </StackPanel.Background>

                    <StackPanel.Resources>
                        <Style x:Key="SlowHoverButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="ButtonBorder"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">

                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal">
                                                        <Storyboard>
                                                            <ColorAnimation 
                                                                Storyboard.TargetName="ButtonBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#00FFFFFF"
                                                                Duration="0:0:0.3"/>
                                                        </Storyboard>
                                                    </VisualState>

                                                    <VisualState x:Name="PointerOver">
                                                        <Storyboard>
                                                            <ColorAnimation 
                                                                Storyboard.TargetName="ButtonBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#40FFFFFF"
                                                                Duration="0:0:0.3"/>
                                                        </Storyboard>
                                                    </VisualState>

                                                    <VisualState x:Name="Pressed">
                                                        <Storyboard>
                                                            <ColorAnimation 
                                                                Storyboard.TargetName="ButtonBorder"
                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                To="#20FFFFFF"
                                                                Duration="0:0:0.1"/>
                                                        </Storyboard>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>

                                            <ContentPresenter 
                                                Content="{TemplateBinding Content}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Botão Hamburger -->
                    <Button x:ConnectionId='9' 
                        x:Name="ToggleButton"
                                                  
                        Width="200"
                        Height="50"
                        Style="{StaticResource SlowHoverButtonStyle}">
                        <FontIcon Glyph="&#xE700;" FontSize="20"/>
                    </Button>

                    <!-- Botão Home -->
                    <Button x:ConnectionId='10' Width="200" Height="45" Style="{StaticResource SlowHoverButtonStyle}"                         >
                        <Grid Width="170">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE80F;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:ConnectionId='15' x:Name="TextHome" x:Uid="MenuHome" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Botão Passwords -->
                    <Button x:ConnectionId='11' Width="200" Height="45" Style="{StaticResource SlowHoverButtonStyle}"                              >
                        <Grid Width="170">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:ConnectionId='14' x:Name="TextPasswords" x:Uid="MenuPasswords" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Botão Settings -->
                    <Button x:ConnectionId='12' Width="200" Height="45" Style="{StaticResource SlowHoverButtonStyle}"                             >
                        <Grid Width="170">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:ConnectionId='13' x:Name="TextSettings" x:Uid="MenuSettings" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </SplitView.Pane>

            <!--(SplitView.Content) é o conteúdo principal, o que fica ao lado do conteúdo principal-->
            <SplitView.Content>
                <Frame x:ConnectionId='16' x:Name="ContentFrame"/> <!--Este Frame é para poder navegar dentro da MainPage-->
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>

