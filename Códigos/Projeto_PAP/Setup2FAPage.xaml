<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Projeto_PAP.Setup2FAPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projeto_PAP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="White">

    <!-- Centrado vertical e horizontal -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- Card principal -->
        <Border 
            Background="White" 
            CornerRadius="16" 
            Padding="40"
            BorderBrush="#e0e0e0"
            BorderThickness="1"
            MaxWidth="900">

            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <StackPanel Spacing="25">

                <!-- Título -->
                <TextBlock 
                    x:Uid="Setup2FA_Title"
                    Text="Set Up Two-Factor Authentication"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="#1a1a2e"
                    HorizontalAlignment="Center"/>

                <!-- Aviso -->
                <Border Background="#FFF3CD" CornerRadius="8" Padding="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="#856404"/>
                        <TextBlock 
                            x:Uid="Setup2FA_WarningText"
                            Text="To continue using this application, you must set up two-factor authentication for your security."
                            TextWrapping="Wrap"
                            FontSize="14"
                            Foreground="#856404"
                            MaxWidth="700"/>
                    </StackPanel>
                </Border>

                <!-- Conteúdo principal: QR à esquerda, Instruções à direita -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ESQUERDA: QR Code -->
                    <StackPanel Grid.Column="0" Spacing="15" VerticalAlignment="Center">
                        <Border 
                            Background="#f9f9f9" 
                            CornerRadius="12" 
                            Padding="20"
                            BorderBrush="#e0e0e0"
                            BorderThickness="1">
                            <Image 
                                x:Name="QRCodeImage"
                                Width="200"
                                Height="200"
                                Stretch="Uniform"/>
                        </Border>

                        <!-- Chave manual -->
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock 
                                x:Uid="Setup2FA_ManualEntry"
                                Text="Can't scan? Enter this code manually:"
                                FontSize="12"
                                Foreground="#888888"
                                HorizontalAlignment="Center"/>
                            <Border Background="#f5f5f5" CornerRadius="6" Padding="12,8">
                                <TextBlock 
                                    x:Name="SecretKeyText"
                                    Text=""
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#333333"
                                    IsTextSelectionEnabled="True"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- DIREITA: Instruções e código -->
                    <StackPanel Grid.Column="2" Spacing="20" VerticalAlignment="Center">

                        <!-- Passos -->
                        <StackPanel Spacing="15">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="#667eea" CornerRadius="15" Width="30" Height="30">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock 
                                    x:Uid="Setup2FA_Step1"
                                    Text="Install Google Authenticator on your phone"
                                    FontSize="14"
                                    Foreground="#333333"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="#667eea" CornerRadius="15" Width="30" Height="30">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock 
                                    x:Uid="Setup2FA_Step2"
                                    Text="Scan the QR Code"
                                    FontSize="14"
                                    Foreground="#333333"
                                    VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="#667eea" CornerRadius="15" Width="30" Height="30">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock 
                                    x:Uid="Setup2FA_Step3"
                                    Text="Enter the 6-digit code from the app:"
                                    FontSize="14"
                                    Foreground="#333333"
                                    VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Campo do código -->
                        <TextBox 
                            x:Name="CodeBox"
                            x:Uid="Setup2FA_CodeBox"
                            PlaceholderText="000000"
                            MaxLength="6"
                            FontSize="32"
                            FontFamily="Consolas"
                            TextAlignment="Center"
                            Width="200"
                            CornerRadius="8"
                            Padding="15"
                            InputScope="NumericPin"
                            HorizontalAlignment="Left"/>

                        <!-- Mensagem de erro -->
                        <TextBlock 
                            x:Name="ErrorMessage"
                            x:Uid="Setup2FA_Error"
                            Text="Invalid code. Please try again."
                            Foreground="#e74c3c"
                            FontSize="13"
                            Visibility="Collapsed"/>

                        <!-- Botão Confirmar -->
                        <Button 
                            x:Name="ConfirmButton"
                            x:Uid="Setup2FA_ConfirmButton"
                            Content="Confirm"
                            Click="ConfirmButton_Click"
                            Background="#667eea"
                            Foreground="White"
                            FontSize="16"
                            Padding="30,12"
                            CornerRadius="8"
                            HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Page>