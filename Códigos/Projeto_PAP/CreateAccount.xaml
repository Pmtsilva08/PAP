<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Projeto_PAP.CreateAccount"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projeto_PAP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <Grid.Resources>
            <Style x:Key="ButtonStyle"  TargetType="Button"> <!--Aqui são aplicados os estilos-->
                <Setter Property="Background">
                    <Setter.Value>
                        <!--0                    1
                        0   ┌────────────────────┐
                            │                    │
                            │                    │
                            │                    │
                        1   └────────────────────┘-->
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"> 
                            <GradientStop Color="#667eea" Offset="0.0"/> <!--Aqui é onde a cor começa-->
                            <GradientStop Color="#764ba2" Offset="1.0"/>
                            <!--Aqui é onde a cor termina e começa outra-->
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <!--Como vai ser construido cada botão que utilizar a propriedade style cujo x:Key é igual a x:Key="ButtonStyle"-->
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter 
                                        Content="{TemplateBinding Content}"
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <StackPanel 
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="white"
        Height="580"
        Width="450"
        CornerRadius="13,13,0,0"
        Orientation="Vertical"
        Spacing="5">
            
            <Image Source="/Assets/Icon_App_Grande.png"
                   Width="80" 
                   Height="80" 
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>
            
            <TextBlock
            Text="First Name" FontSize="16" HorizontalAlignment="Center" Foreground="Black"/>
            <TextBox x:Name="FirstNameTextBox" Width="300" PlaceholderText="Enter your first name..." HorizontalAlignment="Center"/>

            <TextBlock
            Text="Last Name" FontSize="16" HorizontalAlignment="Center" Foreground="Black" Margin="0,20,0,0"/>
            <TextBox x:Name="LastNameTextBox" Width="300" PlaceholderText="Enter your last name..." HorizontalAlignment="Center"/>
            
            <TextBlock
            Text="Email Address" FontSize="16" HorizontalAlignment="Center" Foreground="Black" Margin="0,20,0,0"/>
            <TextBox x:Name="EmailTextBox" Width="300" PlaceholderText="Enter your email..." HorizontalAlignment="Center"/>
            
            <TextBlock
            Text="Password" FontSize="16" HorizontalAlignment="Center" Foreground="Black" Margin="0,20,0,0"/>
            <PasswordBox x:Name="PasswordBox" Width="300" PlaceholderText="Enter your password..." HorizontalAlignment="Center"/>

            <TextBlock
            Text="Confirm Password" FontSize="16" HorizontalAlignment="Center" Foreground="Black" Margin="0,20,0,0"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Width="300" PlaceholderText="Confirm your password..." HorizontalAlignment="Center"/>

            <Button
            x:Name="CreateAccountButton"
            Content="Create Account"
            Width="140"
            Click="CreateAccountClick"
            HorizontalAlignment="Center"
            Style="{StaticResource ButtonStyle}"
            Margin="0,20,0,0"/>
        </StackPanel>

        <StackPanel Background="white" Width="450" Height="50" Orientation="Vertical" HorizontalAlignment="Center" Margin="0, 630, 0, 0" CornerRadius="0,0,13,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-8">
                <TextBlock Text="Already have an account?" FontSize="14" VerticalAlignment="Center"/>
                <HyperlinkButton Content="Login" Click="Login_Click" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
