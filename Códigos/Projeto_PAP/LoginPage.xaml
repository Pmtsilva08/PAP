<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Projeto_PAP.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Projeto_PAP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0.0"/>
                            <GradientStop Color="#764ba2" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter 
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Estilo para os botões de idioma -->
            <Style x:Key="LanguageButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="15,10"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
        </Grid.Resources>

        <StackPanel 
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            Height="520"
            Width="460"
            CornerRadius="13,13,0,0"
            Orientation="Vertical"
            Spacing="5">

            <Image Source="/Assets/Icon_App_Grande.png"
                Width="80" 
                Height="80" 
                HorizontalAlignment="Center"
                Margin="0,10,0,10"/>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- SELETOR DE IDIOMA BONITO -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <Button x:Name="LanguageButton"
                    HorizontalAlignment="Center"
                    Background="#f5f5f5"
                    BorderBrush="#e0e0e0"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="15,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="CurrentFlag" Text="🇬🇧" FontSize="18"/>
                    <TextBlock x:Name="CurrentLanguageName" Text="English" FontSize="14" VerticalAlignment="Center"/>
                    <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="#888"/>
                </StackPanel>

                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Spacing="5" Width="180">
                            <!-- Inglês -->
                            <Button Style="{StaticResource LanguageButtonStyle}"
                                    Tag="en-US"
                                    Click="LanguageOption_Click"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="🇬🇧" FontSize="20"/>
                                    <TextBlock Text="English" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Português -->
                            <Button Style="{StaticResource LanguageButtonStyle}"
                                    Tag="pt-PT"
                                    Click="LanguageOption_Click"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="🇵🇹" FontSize="20"/>
                                    <TextBlock Text="Português" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Espanhol -->
                            <Button Style="{StaticResource LanguageButtonStyle}"
                                    Tag="es-ES"
                                    Click="LanguageOption_Click"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="🇪🇸" FontSize="20"/>
                                    <TextBlock Text="Español" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Francês -->
                            <Button Style="{StaticResource LanguageButtonStyle}"
                                    Tag="fr-FR"
                                    Click="LanguageOption_Click"
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="🇫🇷" FontSize="20"/>
                                    <TextBlock Text="Français" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- FORMULÁRIO -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <TextBlock x:Name="EmailLabel"
                Text="Email Address" 
                FontSize="16" 
                HorizontalAlignment="Center" 
                Foreground="Black" 
                Margin="0,15,0,0"/>
            <TextBox x:Name="EmailTextBox" 
                Width="300" 
                PlaceholderText="Enter your email..." 
                HorizontalAlignment="Center"/>

            <TextBlock x:Name="PasswordLabel"
                Text="Password" 
                FontSize="16" 
                HorizontalAlignment="Center" 
                Foreground="Black" 
                Margin="0,20,0,0"/>
            <PasswordBox x:Name="PasswordBox" 
                Width="300" 
                PlaceholderText="Enter your password..." 
                HorizontalAlignment="Center"/>

            <!-- Link Esqueceu a palavra-passe -->
            <HyperlinkButton x:Name="ForgotPasswordLink"
                Content="Forgot your password?"
                Click="ForgotPassword_Click"
                HorizontalAlignment="Center"
                Margin="0,5,0,0"
                FontSize="12"/>

            <Button x:Name="LoginButton"
                Content="Login" 
                Width="140"
                Click="LoginClick"
                HorizontalAlignment="Center"
                Style="{StaticResource ButtonStyle}"
                Margin="0,20,0,0"/>
        </StackPanel>

        <StackPanel Background="White" Width="460" Height="90" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,450,0,0" CornerRadius="0,0,13,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-8">
                <TextBlock x:Name="NoAccountText" 
                    Text="Don't have an account yet?" 
                    FontSize="14" 
                    VerticalAlignment="Center"/>
                <HyperlinkButton x:Name="CreateAccountLink" 
                    Content="Create Account" 
                    Click="Create_Click" 
                    FontSize="14" 
                    VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>