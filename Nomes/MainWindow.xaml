<Window x:Class="Nomes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nomes"
        mc:Ignorable="d"
        Title="Nomes" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions> <!--Aqui defino as linhas da minha Grid. É como se fosse uma tabela em Exel.-->
            <RowDefinition Height="Auto"/> <!--Define a altura da primeira linha (linha 0) linha como automática, ou seja, ela ajusta o seu tamanho ao conteúdo.-->
            <RowDefinition Height="*"/> <!--Define a altura da segunda linha (linha 1) linha como automática, ou seja, neste caso ela ficará com o restante da altura disponível.-->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions><!--Aqui defino as colunas da minha Grid.-->
            <ColumnDefinition Width="*"/>
            <!--Define a largura da primeira coluna (coluna 0). O asterisco * significa "tamanho proporcional automático", ou seja, neste caso ambas as colunas existentes como têm as duas * vão ocuopar 50% da largura.-->
            <ColumnDefinition Width="*"/>
            <!--Define a largura da segunda coluna (coluna 1). O asterisco * significa "tamanho proporcional automático", ou seja, neste caso ambas as colunas existentes como têm as duas * vão ocuopar 50% da largura.-->
        </Grid.ColumnDefinitions>

        <Label>Nomes</Label>
        <!--Adiciona um rótulo (Label) com o texto "Nomes".-->


    </Grid>
</Window>
