<Application x:Class="Nomes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nomes"
             StartupUri="MainWindow.xaml">
             <!--1. Aplicação inicia
                        ↓
                 2. WPF lê o App.xaml
                        ↓
                 3. Vê: StartupUri="MainWindow.xaml"
                        ↓
                 4. WPF faz automaticamente:
                 MainWindow janela = new MainWindow();  ← AQUI!
                        ↓
                 5. O construtor executa
                        ↓
                 6. InitializeComponent() cria os controlos
                        ↓
                 7. Janela aparece no ecrã-->
    <Application.Resources>
         
    </Application.Resources>
</Application>
